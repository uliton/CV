[Unit]
Description=CV content API
After=network.target

[Service]
Type=simple
User=alex
WorkingDirectory=/home/alex/cv-backend/current/backend
EnvironmentFile=/home/alex/cv-backend/config.env
Environment=CV_CONTENT_FILE=/home/alex/cv-backend/data/content.json
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/alex/cv-backend/data
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
